# --- Persona ---
NIE=X0000000X
NOMBRE="NOMBRE APELLIDO"
# Código de país en el desplegable de la web (406 = CHINA)
PAIS_CODIGO=406

# --- Oficina: 99 = cualquier oficina de Barcelona ---
SEDE=99

# --- Aviso por correo (Resend) ---
# Sin dominio verificado en Resend: remitente onboarding@resend.dev y solo
# se puede enviar al email de la cuenta de Resend.
MAIL_TO=cjf110120130@gmail.com
MAIL_FROM="Monitor Citas <onboarding@resend.dev>"
RESEND_API_KEY=

# --- Reserva automática ---
# true = intenta coger la primera hora disponible; false = solo avisa
AUTO_BOOK=false
# Necesarios para reservar (la web los pide)
TELEFONO=600000000
EMAIL_CITA=cjf110120130@gmail.com

# --- Frecuencia (minutos). Menos de 2 = mucho riesgo de bloqueo de IP ---
INTERVALO_MIN=2
INTERVALO_MAX=3
# Segundos de espera tras "no hay citas" (vacío = usar INTERVALO_MIN/MAX).
# Muy bajo = alto riesgo de bloqueo de IP
ESPERA_SIN_CITAS_SEG=5

# --- Aviso por SMS (Textbelt) ---
TEXTBELT_API_KEY=
SMS_PHONE=+34600000000

# --- Presentación con Cl@ve (certificado electrónico) ---
# Con Cl@ve hay citas que no aparecen sin Cl@ve
USE_CLAVE=false
CERT_PFX_PATH=/ruta/al/certificado.pfx
CERT_PASSWORD=
